<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ERP Preventivi</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <style>
        body { background-color: #f8f9fa; }
        .navbar-brand { font-weight: bold; letter-spacing: 1px; }
        .badge-Bozza      { background-color: #6c757d; }
        .badge-Inviato    { background-color: #0d6efd; }
        .badge-Accettato  { background-color: #198754; }
        .badge-Rifiutato  { background-color: #dc3545; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" href="/"><i class="bi bi-file-earmark-text me-2"></i>ERP Preventivi</a>
            <div class="navbar-nav ms-auto">
                <a class="nav-link" asp-controller="Preventivi" asp-action="Index">
                    <i class="bi bi-list-ul me-1"></i>Preventivi
                </a>
                <a class="nav-link" asp-controller="Preventivi" asp-action="Create">
                    <i class="bi bi-plus-circle me-1"></i>Nuovo
                </a>
            </div>
        </div>
    </nav>

    <div class="container">
        @* Messaggi di feedback *@
        @if (TempData["Successo"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle me-2"></i>@TempData["Successo"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
