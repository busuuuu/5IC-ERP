@page
@model ERP_Ordini.Pages.Ordini.DeleteModel
@{
    ViewData["Title"] = "Elimina Ordine";
}

<div class="container mt-4">
    <h1>Elimina Ordine</h1>

    <div class="alert alert-danger mt-3">
        Sei sicuro di voler eliminare questo ordine?
    </div>

    <div class="card mt-3">
        <div class="card-body">
            <p><strong>ID Ordine:</strong> @Model.Ordine.IdOrdine</p>
            <p><strong>Stato Ordine:</strong> @Model.Ordine.Stato</p>
            <p><strong>Cliente:</strong> @Model.Ordine.DettagliOrdine?.IdCliente</p>
            <p><strong>Data Ordine:</strong> @Model.Ordine.DettagliOrdine?.DataOrdine.ToShortDateString()</p>
        </div>
    </div>

    <form method="post" class="mt-3">
        <button type="submit" class="btn btn-danger">Elimina</button>
        <a asp-page="Index" class="btn btn-secondary ms-2">Annulla</a>
    </form>
</div>