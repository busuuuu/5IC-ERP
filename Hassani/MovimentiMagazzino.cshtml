@page
@model TechLogixERP.Pages.MovimentiMagazzinoModel
@{
    ViewData["Title"] = "Movimenti Magazzino";
    // Calcola il massimo per il grafico (usato inline per le altezze barre)
    int chartMax = Model.ChartData.Any()
        ? Model.ChartData.Max(d => Math.Max(d.Carichi, d.Scarichi))
        : 1;
    if (chartMax == 0) chartMax = 1;
}

<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>TechLogix ERP — Movimenti Magazzino</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Mono:wght@400;500&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet"/>
<style>
  :root {
    --bg: #0c0f14; --surface: #131820; --surface2: #1a2130; --border: #222d3d;
    --accent: #00e5ff; --accent2: #ff6b35; --green: #00e676; --red: #ff3d5a;
    --yellow: #ffd740; --text: #e8edf5; --text-muted: #5a6a80; --text-dim: #8899ab;
    --font-display: 'Syne', sans-serif; --font-body: 'DM Sans', sans-serif; --font-mono: 'DM Mono', monospace;
  }
  * { margin:0; padding:0; box-sizing:border-box; }
  body { background:var(--bg); color:var(--text); font-family:var(--font-body); min-height:100vh; overflow-x:hidden; }
  body::before {
    content:''; position:fixed; inset:0;
    background-image: linear-gradient(rgba(0,229,255,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(0,229,255,0.03) 1px, transparent 1px);
    background-size:40px 40px; pointer-events:none; z-index:0;
  }
  /* SIDEBAR */
  .sidebar { position:fixed; left:0; top:0; bottom:0; width:220px; background:var(--surface); border-right:1px solid var(--border); display:flex; flex-direction:column; z-index:100; padding:24px 0; }
  .logo { padding:0 20px 28px; border-bottom:1px solid var(--border); }
  .logo-tag { font-family:var(--font-mono); font-size:10px; color:var(--accent); letter-spacing:3px; text-transform:uppercase; margin-bottom:4px; }
  .logo-name { font-family:var(--font-display); font-size:18px; font-weight:800; color:var(--text); line-height:1.1; }
  .logo-name span { color:var(--accent); }
  .nav { margin-top:20px; flex:1; }
  .nav-section { padding:0 12px; margin-bottom:8px; }
  .nav-label { font-family:var(--font-mono); font-size:9px; color:var(--text-muted); letter-spacing:2px; text-transform:uppercase; padding:0 8px; margin-bottom:4px; }
  .nav-item { display:flex; align-items:center; gap:10px; padding:9px 12px; border-radius:8px; cursor:pointer; font-size:13px; font-weight:400; color:var(--text-dim); transition:all .18s; margin-bottom:2px; text-decoration:none; }
  .nav-item:hover { background:var(--surface2); color:var(--text); }
  .nav-item.active { background:rgba(0,229,255,0.1); color:var(--accent); font-weight:600; border:1px solid rgba(0,229,255,0.2); }
  .nav-icon { font-size:15px; width:18px; text-align:center; }
  .nav-divider { height:1px; background:var(--border); margin:12px 20px; }
  .sidebar-user { padding:16px 20px; border-top:1px solid var(--border); display:flex; align-items:center; gap:10px; }
  .avatar { width:32px; height:32px; background:linear-gradient(135deg,var(--accent),#0055ff); border-radius:8px; display:flex; align-items:center; justify-content:center; font-family:var(--font-display); font-size:12px; font-weight:700; color:#000; flex-shrink:0; }
  .user-info .name { font-size:13px; font-weight:600; }
  .user-info .role { font-size:11px; color:var(--text-muted); }
  /* MAIN */
  .main { margin-left:220px; min-height:100vh; position:relative; z-index:1; }
  .topbar { display:flex; align-items:center; justify-content:space-between; padding:20px 32px; border-bottom:1px solid var(--border); background:rgba(12,15,20,0.8); backdrop-filter:blur(12px); position:sticky; top:0; z-index:50; }
  .page-title { font-family:var(--font-display); font-size:22px; font-weight:800; letter-spacing:-0.5px; }
  .page-title span { color:var(--accent); }
  .breadcrumb { font-size:11px; color:var(--text-muted); font-family:var(--font-mono); margin-top:2px; }
  .topbar-actions { display:flex; gap:10px; align-items:center; }
  .badge-date { font-family:var(--font-mono); font-size:11px; color:var(--text-muted); background:var(--surface2); border:1px solid var(--border); padding:6px 12px; border-radius:6px; }
  /* BUTTONS */
  .btn { display:inline-flex; align-items:center; gap:7px; padding:9px 18px; border-radius:8px; font-size:13px; font-weight:600; cursor:pointer; border:none; font-family:var(--font-body); transition:all .18s; }
  .btn-primary { background:var(--accent); color:#000; }
  .btn-primary:hover { background:#33eaff; transform:translateY(-1px); box-shadow:0 4px 20px rgba(0,229,255,0.3); }
  .btn-ghost { background:transparent; color:var(--text-dim); border:1px solid var(--border); }
  .btn-ghost:hover { background:var(--surface2); color:var(--text); }
  /* CONTENT */
  .content { padding:28px 32px; }
  /* KPI */
  .kpi-row { display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-bottom:28px; }
  .kpi-card { background:var(--surface); border:1px solid var(--border); border-radius:12px; padding:20px; position:relative; overflow:hidden; transition:border-color .2s; }
  .kpi-card:hover { border-color:rgba(0,229,255,0.3); }
  .kpi-card::before { content:''; position:absolute; top:0; left:0; right:0; height:2px; }
  .kpi-card.cyan::before { background:var(--accent); }
  .kpi-card.green::before { background:var(--green); }
  .kpi-card.red::before { background:var(--red); }
  .kpi-card.orange::before { background:var(--accent2); }
  .kpi-label { font-size:11px; font-family:var(--font-mono); color:var(--text-muted); letter-spacing:1px; text-transform:uppercase; margin-bottom:10px; }
  .kpi-value { font-family:var(--font-display); font-size:32px; font-weight:800; line-height:1; margin-bottom:6px; }
  .kpi-card.cyan .kpi-value { color:var(--accent); }
  .kpi-card.green .kpi-value { color:var(--green); }
  .kpi-card.red .kpi-value { color:var(--red); }
  .kpi-card.orange .kpi-value { color:var(--accent2); }
  .kpi-sub { font-size:12px; color:var(--text-muted); }
  .kpi-icon { position:absolute; right:16px; top:50%; transform:translateY(-50%); font-size:36px; opacity:.07; }
  /* MAIN GRID */
  .main-grid { display:grid; grid-template-columns:1fr 340px; gap:20px; margin-bottom:24px; }
  /* PANEL */
  .panel { background:var(--surface); border:1px solid var(--border); border-radius:12px; overflow:hidden; }
  .panel-header { display:flex; align-items:center; justify-content:space-between; padding:16px 20px; border-bottom:1px solid var(--border); }
  .panel-title { font-family:var(--font-display); font-size:14px; font-weight:700; display:flex; align-items:center; gap:8px; }
  .panel-title .dot { width:6px; height:6px; border-radius:50%; background:var(--accent); box-shadow:0 0 6px var(--accent); }
  /* FILTERS */
  .filters-bar { display:flex; gap:10px; align-items:center; padding:14px 20px; border-bottom:1px solid var(--border); flex-wrap:wrap; }
  .search-wrap { position:relative; flex:1; min-width:180px; }
  .search-wrap input { width:100%; background:var(--surface2); border:1px solid var(--border); border-radius:8px; color:var(--text); font-family:var(--font-body); font-size:13px; padding:8px 12px 8px 34px; outline:none; transition:border-color .18s; }
  .search-wrap input:focus { border-color:var(--accent); }
  .search-wrap input::placeholder { color:var(--text-muted); }
  .search-icon { position:absolute; left:10px; top:50%; transform:translateY(-50%); color:var(--text-muted); font-size:14px; pointer-events:none; }
  .filter-select { background:var(--surface2); border:1px solid var(--border); border-radius:8px; color:var(--text-dim); font-family:var(--font-body); font-size:13px; padding:8px 12px; outline:none; cursor:pointer; }
  /* TABLE */
  .table-wrap { overflow-x:auto; }
  table { width:100%; border-collapse:collapse; }
  thead th { font-family:var(--font-mono); font-size:10px; letter-spacing:1.5px; text-transform:uppercase; color:var(--text-muted); padding:11px 16px; text-align:left; border-bottom:1px solid var(--border); white-space:nowrap; }
  tbody tr { border-bottom:1px solid rgba(34,45,61,0.5); transition:background .15s; cursor:pointer; }
  tbody tr:hover { background:rgba(0,229,255,0.04); }
  tbody td { padding:11px 16px; font-size:13px; color:var(--text-dim); white-space:nowrap; }
  tbody td:first-child { color:var(--text); font-weight:500; }
  .mono { font-family:var(--font-mono); font-size:12px; }
  /* BADGES */
  .badge { display:inline-flex; align-items:center; gap:5px; padding:3px 10px; border-radius:20px; font-size:11px; font-weight:600; font-family:var(--font-mono); text-transform:uppercase; letter-spacing:.5px; }
  .badge-in  { background:rgba(0,230,118,.12); color:var(--green); border:1px solid rgba(0,230,118,.25); }
  .badge-out { background:rgba(255,61,90,.12);  color:var(--red);   border:1px solid rgba(255,61,90,.25); }
  .badge-adj { background:rgba(255,215,64,.10); color:var(--yellow);border:1px solid rgba(255,215,64,.25); }
  .badge-ret { background:rgba(255,107,53,.10); color:var(--accent2);border:1px solid rgba(255,107,53,.25); }
  .qty-plus  { color:var(--green); font-family:var(--font-mono); font-weight:600; }
  .qty-minus { color:var(--red);   font-family:var(--font-mono); font-weight:600; }
  .row-num { font-family:var(--font-mono); font-size:10px; color:var(--text-muted); background:var(--surface2); padding:2px 7px; border-radius:4px; }
  /* ALERTS */
  .alerts-section { margin-bottom:24px; }
  .alert-row { display:flex; gap:12px; flex-wrap:wrap; }
  .alert-card { flex:1; min-width:180px; background:var(--surface); border:1px solid rgba(255,61,90,.3); border-radius:10px; padding:14px 16px; display:flex; align-items:center; gap:12px; animation:pulseAlert 2.5s ease-in-out infinite; }
  @keyframes pulseAlert { 0%,100%{box-shadow:0 0 0 0 rgba(255,61,90,.15);}50%{box-shadow:0 0 0 6px rgba(255,61,90,0);} }
  .alert-icon-wrap { width:36px; height:36px; background:rgba(255,61,90,.15); border-radius:8px; display:flex; align-items:center; justify-content:center; font-size:18px; flex-shrink:0; }
  .alert-info { flex:1; }
  .alert-art { font-size:13px; font-weight:600; color:var(--text); }
  .alert-stock { font-family:var(--font-mono); font-size:11px; color:var(--red); }
  .alert-min { font-size:11px; color:var(--text-muted); }
  .section-label { font-family:var(--font-display); font-size:13px; font-weight:700; color:var(--text-muted); letter-spacing:1px; text-transform:uppercase; margin-bottom:12px; display:flex; align-items:center; gap:8px; }
  .section-label::after { content:''; flex:1; height:1px; background:var(--border); }
  /* CHART */
  .chart-wrap { padding:16px 20px 20px; }
  .chart-bars { display:flex; align-items:flex-end; gap:6px; height:80px; }
  .bar-group { flex:1; display:flex; gap:2px; align-items:flex-end; }
  .bar { flex:1; border-radius:3px 3px 0 0; transition:opacity .2s; min-height:4px; }
  .bar:hover { opacity:.8; }
  .bar-in { background:var(--green); }
  .bar-out { background:var(--red); }
  .chart-labels { display:flex; gap:6px; margin-top:8px; }
  .chart-labels span { flex:1; text-align:center; font-family:var(--font-mono); font-size:9px; color:var(--text-muted); }
  .chart-legend { display:flex; gap:16px; margin-bottom:12px; }
  .legend-item { display:flex; align-items:center; gap:6px; font-size:11px; color:var(--text-muted); font-family:var(--font-mono); }
  .legend-dot { width:8px; height:8px; border-radius:2px; }
  /* FORM */
  .form-group { margin-bottom:16px; }
  .form-label { font-family:var(--font-mono); font-size:10px; letter-spacing:1.5px; text-transform:uppercase; color:var(--text-muted); display:block; margin-bottom:6px; }
  .form-input, .form-select, .form-textarea { width:100%; background:var(--surface2); border:1px solid var(--border); border-radius:8px; color:var(--text); font-family:var(--font-body); font-size:13px; padding:9px 12px; outline:none; transition:border-color .18s,box-shadow .18s; }
  .form-input:focus,.form-select:focus,.form-textarea:focus { border-color:var(--accent); box-shadow:0 0 0 3px rgba(0,229,255,.08); }
  .form-input::placeholder,.form-textarea::placeholder { color:var(--text-muted); }
  .form-textarea { resize:vertical; min-height:70px; }
  .type-selector { display:grid; grid-template-columns:1fr 1fr; gap:8px; }
  .type-btn { padding:10px 8px; border-radius:8px; border:1px solid var(--border); background:var(--surface2); cursor:pointer; text-align:center; font-size:12px; font-weight:600; color:var(--text-dim); transition:all .15s; font-family:var(--font-body); }
  .type-btn .t-icon { font-size:18px; display:block; margin-bottom:4px; }
  .type-btn:hover { border-color:var(--accent); color:var(--accent); }
  .type-btn.active-in  { background:rgba(0,230,118,.1);  border-color:var(--green);   color:var(--green); }
  .type-btn.active-out { background:rgba(255,61,90,.1);  border-color:var(--red);     color:var(--red); }
  .type-btn.active-adj { background:rgba(255,215,64,.08);border-color:var(--yellow);  color:var(--yellow); }
  .type-btn.active-ret { background:rgba(255,107,53,.1); border-color:var(--accent2); color:var(--accent2); }
  /* MODAL */
  .modal-overlay { display:none; position:fixed; inset:0; background:rgba(0,0,0,.7); backdrop-filter:blur(4px); z-index:200; align-items:center; justify-content:center; }
  .modal-overlay.open { display:flex; }
  .modal { background:var(--surface); border:1px solid var(--border); border-radius:16px; width:480px; max-width:95vw; overflow:hidden; animation:modalIn .22s cubic-bezier(.34,1.56,.64,1) both; }
  @keyframes modalIn { from{opacity:0;transform:scale(.92) translateY(20px);}to{opacity:1;transform:scale(1) translateY(0);} }
  .modal-header { display:flex; align-items:center; justify-content:space-between; padding:20px 24px; border-bottom:1px solid var(--border); }
  .modal-title { font-family:var(--font-display); font-size:16px; font-weight:800; }
  .modal-close { width:28px; height:28px; background:var(--surface2); border:1px solid var(--border); border-radius:6px; cursor:pointer; color:var(--text-dim); display:flex; align-items:center; justify-content:center; font-size:16px; transition:all .15s; }
  .modal-close:hover { color:var(--red); border-color:var(--red); }
  .modal-body { padding:24px; }
  .modal-footer { display:flex; gap:10px; justify-content:flex-end; padding:16px 24px; border-top:1px solid var(--border); }
  /* TOAST */
  .success-toast { position:fixed; bottom:28px; right:28px; background:var(--surface); border-radius:10px; padding:14px 20px; display:flex; align-items:center; gap:12px; font-size:13px; color:var(--text); box-shadow:0 8px 32px rgba(0,0,0,.4); z-index:300; }
  .success-toast.toast-ok  { border:1px solid rgba(0,230,118,.4); }
  .success-toast.toast-err { border:1px solid rgba(255,61,90,.4); }
  .toast-icon { font-size:18px; }
  @@media (max-width:1100px) { .main-grid{grid-template-columns:1fr;} .kpi-row{grid-template-columns:1fr 1fr;} }
  @@media (max-width:700px)  { .sidebar{display:none;} .main{margin-left:0;} .kpi-row{grid-template-columns:1fr;} }
</style>
</head>
<body>

<!-- SIDEBAR (solo link al proprio modulo + struttura ERP) -->
<aside class="sidebar">
  <div class="logo">
    <div class="logo-tag">ERP</div>
    <div class="logo-name">Tech<span>Logix</span></div>
  </div>
  <nav class="nav">
    <div class="nav-section">
      <div class="nav-label">Magazzino</div>
      <a class="nav-item" asp-page="/Articoli">
        <span class="nav-icon">📦</span> Articoli
      </a>
      <a class="nav-item active" asp-page="/MovimentiMagazzino">
        <span class="nav-icon">🔄</span> Movimenti
      </a>
      <a class="nav-item" asp-page="/Scorte">
        <span class="nav-icon">📊</span> Scorte
      </a>
      <a class="nav-item" asp-page="/Fornitori">
        <span class="nav-icon">🏭</span> Fornitori
      </a>
    </div>
  </nav>
  <div class="sidebar-user">
    <div class="avatar">MH</div>
    <div class="user-info">
      <div class="name">M. Hassani</div>
      <div class="role">Magazzino</div>
    </div>
  </div>
</aside>

<!-- MAIN -->
<main class="main">

  <!-- TOPBAR -->
  <div class="topbar">
    <div>
      <div class="page-title">Movimenti <span>Magazzino</span></div>
      <div class="breadcrumb">ERP / Magazzino / Movimenti</div>
    </div>
    <div class="topbar-actions">
      <div class="badge-date" id="currentDate">@DateTime.Now.ToString("ddd dd MMM yyyy")</div>
      <button class="btn btn-primary" onclick="openModal()">＋ Nuovo Movimento</button>
    </div>
  </div>

  <div class="content">

    <!-- TOAST (server-side) -->
    @if (!string.IsNullOrEmpty(Model.ToastMessage))
    {
        <div class="success-toast @(Model.ToastIsError ? "toast-err" : "toast-ok")" id="serverToast">
            <span class="toast-icon">@(Model.ToastIsError ? "⚠️" : "✅")</span>
            <span>@Model.ToastMessage</span>
        </div>
    }

    <!-- KPI -->
    <div class="kpi-row">
      <div class="kpi-card cyan">
        <div class="kpi-label">Movimenti Oggi</div>
        <div class="kpi-value">@Model.MovimentiOggi</div>
        <div class="kpi-sub">Registrati oggi</div>
        <div class="kpi-icon">🔄</div>
      </div>
      <div class="kpi-card green">
        <div class="kpi-label">Carichi (mese)</div>
        <div class="kpi-value">@Model.CarichiMese</div>
        <div class="kpi-sub">Unità ricevute</div>
        <div class="kpi-icon">📥</div>
      </div>
      <div class="kpi-card red">
        <div class="kpi-label">Scarichi (mese)</div>
        <div class="kpi-value">@Model.SarichiMese</div>
        <div class="kpi-sub">Unità uscite</div>
        <div class="kpi-icon">📤</div>
      </div>
      <div class="kpi-card orange">
        <div class="kpi-label">Sottoscorta</div>
        <div class="kpi-value">@Model.NumSottoscorta</div>
        <div class="kpi-sub">Articoli critici</div>
        <div class="kpi-icon">⚠️</div>
      </div>
    </div>

    <!-- ALERT SOTTOSCORTA -->
    <div class="alerts-section">
      <div class="section-label">⚠️ Alert Sottoscorta</div>
      <div class="alert-row">
        @foreach (var a in Model.AlertSottoscorte)
        {
          <div class="alert-card">
            <div class="alert-icon-wrap">⚠️</div>
            <div class="alert-info">
              <div class="alert-art">@a.Articolo</div>
              <div class="alert-stock">Scorta: @a.Scorta pz</div>
              <div class="alert-min">Minimo: @a.Minimo pz</div>
            </div>
            <button class="btn btn-ghost" style="padding:5px 10px;font-size:11px;flex-shrink:0"
                    onclick="showToast('Ordine rapido creato per @a.Articolo.Split('—')[0].Trim()')">
              Ordina
            </button>
          </div>
        }
      </div>
    </div>

    <!-- MAIN GRID -->
    <div class="main-grid">

      <!-- TABELLA MOVIMENTI -->
      <div class="panel">
        <div class="panel-header">
          <div class="panel-title"><span class="dot"></span>Storico Movimenti</div>
          <div style="display:flex;gap:8px">
            <button class="btn btn-ghost" style="padding:6px 12px;font-size:12px" onclick="exportCSV()">⬇ Esporta</button>
          </div>
        </div>
        <div class="filters-bar">
          <div class="search-wrap">
            <span class="search-icon">🔍</span>
            <input type="text" placeholder="Cerca articolo, causale..." id="searchInput" oninput="filterTable()"/>
          </div>
          <select class="filter-select" id="typeFilter" onchange="filterTable()">
            <option value="">Tutti i tipi</option>
            <option value="CARICO">Carico</option>
            <option value="SCARICO">Scarico</option>
            <option value="RETTIFICA">Rettifica</option>
            <option value="RESO">Reso</option>
          </select>
        </div>
        <div class="table-wrap">
          <table id="movTable">
            <thead>
              <tr>
                <th>#</th><th>Data</th><th>Tipo</th><th>Articolo</th>
                <th>Quantità</th><th>Causale</th><th>Riferimento</th><th>Operatore</th>
              </tr>
            </thead>
            <tbody>
              @{ int idx = Model.Movimenti.Count; }
              @foreach (var m in Model.Movimenti)
              {
                string badgeClass = m.Tipo switch {
                  "CARICO"    => "badge-in",
                  "SCARICO"   => "badge-out",
                  "RETTIFICA" => "badge-adj",
                  "RESO"      => "badge-ret",
                  _ => ""
                };
                string qtyClass = m.Quantita >= 0 ? "qty-plus" : "qty-minus";
                string qtyStr   = (m.Quantita >= 0 ? "+" : "") + m.Quantita;
                <tr data-tipo="@m.Tipo" data-art="@m.Articolo.ToLower()" data-causale="@m.Causale.ToLower()" data-ref="@m.Riferimento.ToLower()">
                  <td><span class="row-num">@(idx.ToString("D2"))</span></td>
                  <td class="mono">@m.Data</td>
                  <td><span class="badge @badgeClass">@m.Tipo</span></td>
                  <td>@m.Articolo</td>
                  <td class="@qtyClass">@qtyStr</td>
                  <td style="color:var(--text)">@m.Causale</td>
                  <td class="mono" style="color:var(--accent);font-size:11px">@m.Riferimento</td>
                  <td style="font-size:12px">@m.Operatore</td>
                </tr>
                idx--;
              }
            </tbody>
          </table>
        </div>
      </div>

      <!-- RIGHT COLUMN -->
      <div style="display:flex;flex-direction:column;gap:16px;">

        <!-- GRAFICO -->
        <div class="panel">
          <div class="panel-header">
            <div class="panel-title"><span class="dot"></span>Andamento 7 Giorni</div>
          </div>
          <div class="chart-wrap">
            <div class="chart-legend">
              <div class="legend-item"><div class="legend-dot" style="background:var(--green)"></div>Carichi</div>
              <div class="legend-item"><div class="legend-dot" style="background:var(--red)"></div>Scarichi</div>
            </div>
            <div class="chart-bars">
              @foreach (var d in Model.ChartData)
              {
                int hIn  = (int)((double)d.Carichi  / chartMax * 76);
                int hOut = (int)((double)d.Scarichi / chartMax * 76);
                if (hIn  < 4 && d.Carichi  > 0) hIn  = 4;
                if (hOut < 4 && d.Scarichi > 0) hOut = 4;
                <div class="bar-group">
                  <div class="bar bar-in"  style="height:@(hIn)px"  title="Carico: @d.Carichi"></div>
                  <div class="bar bar-out" style="height:@(hOut)px" title="Scarico: @d.Scarichi"></div>
                </div>
              }
            </div>
            <div class="chart-labels">
              @foreach (var d in Model.ChartData)
              {
                <span>@d.Giorno</span>
              }
            </div>
          </div>
        </div>

        <!-- TOP ARTICOLI -->
        <div class="panel">
          <div class="panel-header">
            <div class="panel-title"><span class="dot"></span>Articoli Top Movimentati</div>
          </div>
          <div style="padding:12px 16px;">
            @foreach (var a in Model.TopArticoli)
            {
              <div style="margin-bottom:12px;">
                <div style="display:flex;justify-content:space-between;margin-bottom:4px;">
                  <span style="font-size:12px;color:var(--text)">@a.Nome</span>
                  <span style="font-family:var(--font-mono);font-size:11px;color:var(--accent)">@a.Movimenti mov</span>
                </div>
                <div style="background:var(--surface2);border-radius:4px;height:4px;overflow:hidden">
                  <div style="background:var(--accent);height:100%;width:@(a.Percentuale)%;border-radius:4px;"></div>
                </div>
              </div>
            }
          </div>
        </div>

      </div><!-- end right col -->
    </div><!-- end main-grid -->
  </div><!-- end content -->
</main>

<!-- MODAL NUOVO MOVIMENTO -->
<div class="modal-overlay" id="modalOverlay" onclick="handleOverlayClick(event)">
  <div class="modal">
    <div class="modal-header">
      <div class="modal-title">➕ Nuovo Movimento</div>
      <div class="modal-close" onclick="closeModal()">✕</div>
    </div>
    <form method="post">
      @Html.AntiForgeryToken()
      <div class="modal-body">

        <!-- Tipo -->
        <div class="form-group">
          <label class="form-label">Tipo Movimento</label>
          <input type="hidden" name="NuovoTipo" id="hiddenTipo" value="CARICO"/>
          <div class="type-selector">
            <button type="button" class="type-btn active-in"  id="type-CARICO"    onclick="selectType('CARICO')">   <span class="t-icon">📥</span>Carico</button>
            <button type="button" class="type-btn"            id="type-SCARICO"   onclick="selectType('SCARICO')">  <span class="t-icon">📤</span>Scarico</button>
            <button type="button" class="type-btn"            id="type-RETTIFICA" onclick="selectType('RETTIFICA')"><span class="t-icon">🔧</span>Rettifica</button>
            <button type="button" class="type-btn"            id="type-RESO"      onclick="selectType('RESO')">     <span class="t-icon">↩️</span>Reso</button>
          </div>
        </div>

        <!-- Articolo -->
        <div class="form-group">
          <label class="form-label">Articolo</label>
          <select class="form-select" name="NuovoArticolo">
            <option value="">— Seleziona articolo —</option>
            <option>SEN-TEMP-01 — Sensore Temperatura</option>
            <option>SEN-HUM-02 — Sensore Umidità</option>
            <option>GW-DOM-01 — Gateway Domotico</option>
            <option>ANT-EXT-03 — Antenna Esterna</option>
            <option>PCB-MAIN-01 — Scheda Madre</option>
            <option>CASE-STD-02 — Case Standard</option>
            <option>PSU-5V-01 — Alimentatore 5V</option>
            <option>CAB-USB-01 — Cavo USB-C</option>
          </select>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
          <div class="form-group">
            <label class="form-label">Quantità</label>
            <input class="form-input" type="number" name="NuovoQty" placeholder="0" min="1"/>
          </div>
          <div class="form-group">
            <label class="form-label">Data</label>
            <input class="form-input" type="date" name="NuovaData" value="@DateTime.Today.ToString("yyyy-MM-dd")"/>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">Causale</label>
          <input class="form-input" type="text" name="NuovaCausale" placeholder="es. Acquisto fornitore, Produzione..."/>
        </div>
        <div class="form-group">
          <label class="form-label">Riferimento Documento</label>
          <input class="form-input" type="text" name="NuovoRiferimento" placeholder="es. ODA-2026-041"/>
        </div>
        <div class="form-group">
          <label class="form-label">Note</label>
          <textarea class="form-textarea" name="NuoveNote" placeholder="Note aggiuntive..."></textarea>
        </div>

      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-ghost" onclick="closeModal()">Annulla</button>
        <button type="submit" class="btn btn-primary">Registra Movimento</button>
      </div>
    </form>
  </div>
</div>

<!-- TOAST JS (feedback lato client) -->
<div class="success-toast toast-ok" id="jsToast" style="display:none">
  <span class="toast-icon">✅</span>
  <span id="jsToastMsg"></span>
</div>

<script>
// ── SIDEBAR ACTIVE ──
document.querySelectorAll('.nav-item').forEach(a => {
  if (a.getAttribute('href') === window.location.pathname) a.classList.add('active');
});

// ── SERVER TOAST auto-hide ──
const serverToast = document.getElementById('serverToast');
if (serverToast) { setTimeout(() => serverToast.style.opacity = '0', 3000); }

// ── TIPO SELECTOR ──
let selectedType = 'CARICO';
function selectType(type) {
  selectedType = type;
  document.getElementById('hiddenTipo').value = type;
  const map = {CARICO:'in', SCARICO:'out', RETTIFICA:'adj', RESO:'ret'};
  ['CARICO','SCARICO','RETTIFICA','RESO'].forEach(t => {
    const btn = document.getElementById('type-' + t);
    btn.className = 'type-btn' + (t === type ? ' active-' + map[t] : '');
  });
}

// ── MODAL ──
function openModal()  { document.getElementById('modalOverlay').classList.add('open'); }
function closeModal() { document.getElementById('modalOverlay').classList.remove('open'); }
function handleOverlayClick(e) { if (e.target === document.getElementById('modalOverlay')) closeModal(); }
document.addEventListener('keydown', e => { if(e.key === 'Escape') closeModal(); });

// ── CLIENT FILTER (lato JS, senza round-trip al server) ──
function filterTable() {
  const q = document.getElementById('searchInput').value.toLowerCase();
  const t = document.getElementById('typeFilter').value;
  document.querySelectorAll('#movTable tbody tr').forEach(row => {
    const matchQ = !q || row.dataset.art.includes(q) || row.dataset.causale.includes(q) || row.dataset.ref.includes(q);
    const matchT = !t || row.dataset.tipo === t;
    row.style.display = (matchQ && matchT) ? '' : 'none';
  });
}

// ── TOAST CLIENT ──
function showToast(msg) {
  const t = document.getElementById('jsToast');
  document.getElementById('jsToastMsg').textContent = msg;
  t.style.display = 'flex';
  setTimeout(() => t.style.display = 'none', 3000);
}

// ── EXPORT CSV ──
function exportCSV() {
  const rows = [['ID','Data','Tipo','Articolo','Quantità','Causale','Riferimento','Operatore']];
  document.querySelectorAll('#movTable tbody tr').forEach(row => {
    const cells = row.querySelectorAll('td');
    rows.push([
      cells[0].textContent.trim(),
      cells[1].textContent.trim(),
      cells[2].textContent.trim(),
      cells[3].textContent.trim(),
      cells[4].textContent.trim(),
      cells[5].textContent.trim(),
      cells[6].textContent.trim(),
      cells[7].textContent.trim()
    ]);
  });
  const csv = rows.map(r => r.join(',')).join('\n');
  const a = document.createElement('a');
  a.href = 'data:text/csv;charset=utf-8,' + encodeURIComponent(csv);
  a.download = 'movimenti_magazzino.csv';
  a.click();
  showToast('📥 Esportazione CSV completata!');
}
</script>
</body>
</html>
