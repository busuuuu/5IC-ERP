@page
@model FornitoriERP.Pages.Fornitori.IndexModel

@{
    ViewData["Title"] = "Elenco Fornitori";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="h2">Gestione Fornitori</h1>
        </div>
        <div class="col-md-4 text-md-end">
            <a href="@Url.Page("./Create")" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Nuovo Fornitore
            </a>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-9">
                    <input type="text" name="searchTerm" class="form-control" 
                           placeholder="Cerca per nome, contatto, email o telefono..." 
                           value="@Model.SearchTerm" />
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-outline-primary w-100">
                        <i class="bi bi-search"></i> Cerca
                    </button>
                </div>
                @if (!string.IsNullOrEmpty(Model.SearchTerm))
                {
                    <div class="col-12">
                        <a href="@Url.Page("./Index")" class="btn btn-sm btn-secondary">
                            <i class="bi bi-x-circle"></i> Azzera ricerca
                        </a>
                    </div>
                }
            </form>
        </div>
    </div>

    @if (Model.Fornitori.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Nome Fornitore</th>
                        <th>Contatto</th>
                        <th>Telefono</th>
                        <th>Email</th>
                        <th class="text-center" style="width: 120px;">Azioni</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var fornitore in Model.Fornitori)
                    {
                        <tr>
                            <td><strong>@fornitore.NomeFornitore</strong></td>
                            <td>@fornitore.ContattoFornitore</td>
                            <td>@fornitore.Telefono</td>
                            <td>@fornitore.Email</td>
                            <td class="text-center">
                                <a href="@Url.Page("./Details", new { id = fornitore.IdFornitore })" 
                                   class="btn btn-sm btn-info" title="Visualizza">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a href="@Url.Page("./Edit", new { id = fornitore.IdFornitore })" 
                                   class="btn btn-sm btn-warning" title="Modifica">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a href="@Url.Page("./Delete", new { id = fornitore.IdFornitore })" 
                                   class="btn btn-sm btn-danger" title="Elimina">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            <i class="bi bi-info-circle"></i> 
            @if (string.IsNullOrEmpty(Model.SearchTerm))
            {
                <span>Nessun fornitore trovato nel sistema. <a href="@Url.Page("./Create")">Crea il primo fornitore</a>.</span>
            }
            else
            {
                <span>Nessun fornitore corrisponde ai criteri di ricerca.</span>
            }
        </div>
    }
</div>

<style>
    .table-hover tbody tr:hover {
        background-color: #f5f5f5;
    }
</style>
